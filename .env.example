# Copy this file to .env and edit before running `docker compose up`.
# ------------------------------------------------------------------

# --- Core / security ---------------------------------------------------
SECRET_KEY=changeme-generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# While true, POST /auth/register works exactly once (to create the owner
# account) and then locks itself. Set to false any time to hard-disable it.
ALLOW_REGISTRATION_IF_EMPTY=true

# --- Postgres (pgvector) ------------------------------------------------
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobsearch
# Used by the FastAPI app (async driver)
DATABASE_URL=postgresql+asyncpg://jobsearch:changeme@postgres:5432/jobsearch
# Used by the RQ worker + APScheduler process (sync driver)
SYNC_DATABASE_URL=postgresql+psycopg://jobsearch:changeme@postgres:5432/jobsearch

# --- Redis (RQ queues) ---------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ollama (local LLM) ---------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Chat/reasoning model used for CV extraction, match explanations, cover
# letters, and the copilot chat. Swap for qwen2.5:7b-instruct, mistral, etc.
OLLAMA_CHAT_MODEL=llama3.1:8b
# Embedding model used for the smart-match vector pipeline. If you change
# this to a model with a different output dimension, you MUST also update
# OLLAMA_EMBED_DIM and run a new migration (see README).
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# --- File uploads ---------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# --- Job source API keys (all optional; sources without a key are simply
# skipped by the scheduler rather than erroring) ---------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna country code used for default job + salary lookups (e.g. us, gb, ca)
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com
# Optional, raises BLS API rate limits. The BLS salary source is opt-in and
# empty by default even with a key set - see backend/app/integrations/salary_apis/bls.py
BLS_API_KEY=

# --- Scheduling -------------------------------------------------------------
# How often (minutes) the scheduler sweeps for job sources that are due to
# be polled. Each job_source also has its own poll_interval_minutes.
SCHEDULER_SWEEP_INTERVAL_MINUTES=5
DEFAULT_JOB_POLL_INTERVAL_MINUTES=60
SALARY_REFRESH_CRON_HOUR=3

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api
